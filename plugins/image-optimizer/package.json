{
  "name": "@local/image-optimizer",
  "version": "1.0.0",
  "description": "Converts raster images to WebP during build and rewrites HTML image references",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@quartz-community/types": "github:quartz-community/types",
    "@quartz-community/utils": "github:quartz-community/utils",
    "sharp": "^0.33.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/node": "^24.10.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "quartz": {
    "name": "image-optimizer",
    "displayName": "Image Optimizer",
    "description": "Converts raster images to WebP during build and rewrites HTML image references",
    "version": "1.0.0",
    "category": ["transformer", "emitter"]
  }
}
